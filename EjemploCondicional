#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    float area, lado1, lado2, lado3, s;
    
    cout << "Ingrese el lado 1: ";
    cin >> lado1;
    cout << "Ingrese el lado 2: ";
    cin >> lado2;
    cout << "Ingrese el lado 3: ";
    cin >> lado3;
    
   
    s = (lado1 + lado2 + lado3) / 2;
    
    area = sqrt(s * (s - lado1) * (s - lado2) * (s - lado3));
    
    cout << "El semiperimetro (s) es: " << s << endl;
    cout << "El area del triángulo es: " << area << endl;
    
    return 0;
}
