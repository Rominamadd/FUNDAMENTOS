#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int n;
    bool flag = false;

    cout << "Ingrese un numero entero: ";
    cin >> n;

    for (int i = 2; i<n;i++)
        if (n % i == 0) {
            flag=true;
            break;
        }
    if (flag == true)
        cout << n << " no es primo." << endl;
    else
        cout << n << "es primo." << endl;

    return 0;
}
