int precio(int x) {
    int costo;
    if (x <= 2)
        costo = 15;
    else if (x > 2 && x<=5)
        costo = 25;
    else if (x > 5 && x <= 10)
        costo = 40;
    else
        costo = 60;
    return costo;
}
    
float totalapagar(int cantidad, float precio) {
    float resultado, descuento;
    if (cantidad < 3)
        descuento = (cantidad * precio) * 0, 1;
        resultado = (cantidad * precio) - descuento;
    }
    else {
        descuento = (cantidad * precio) * 0, 2;
        resultado = (cantidad * precio) - descuento;
    }
    return resultado;

}
