#include <iostream>
#include <cmath>
using namespace std;

int main(){
    int  i, n, cont = 2;
    bool flag;
    cout<<"Ingrese la cantidad de  numeros  primos que quiere generar: ";
    cin>>n;
    while (cont < n){
        flag = true;
        for (i = 2; i<=sqrt(cont);i ++)
            if(cont%i==0){
               flag=false;
               break;
           }  
        if(flag==true)
           cout<<cont<<" , ";
        cont++;
    }
    return 0;
}
