#include <iostream>

using namespace std;

int main() {
    float nota1, nota2, nota3, nota4;

    cout << "Ingrese la primera calificacion: ";
    cin >> nota1;

    cout << "Ingrese la segunda calificacion: ";
    cin >> nota2;

    cout << "Ingrese la tercera calificacion: ";
    cin >> nota3;

    cout << "Ingrese la cuarta calificacion: ";
    cin >> nota4;

    if (nota1 < 0 || nota1 > 10 
    ||nota2 < 0 || nota2 > 10 
    ||nota3 < 0 || nota3 > 10 
    ||nota4 < 0 || nota4 > 10) {
        
        cout << "Error: Las calificaciones deben estar en el rango de 0 a 10" << endl;
        return 1;
    }

    float promedio = (nota1 + nota2 + nota3 + nota4) / 4.0;
    cout << "El promedio es: " << promedio << endl;

    if (promedio >= 6.0 && promedio <= 10.0) {
        cout << "Estado: Aprobado" << endl;
    } 
    else if (promedio >= 5.0 && promedio < 6.0) {
        cout << "Estado: Derecho a extraordinario" << endl;
    } 
    else if (promedio >= 2.0 && promedio < 5.0) {
        cout << "Estado: Derecho a titulo" << endl;
    } 
    else if (promedio >= 0.0 && promedio < 2.0) {
        cout << "Estado: Sin derecho a acreditar" << endl;
    }

    return 0;
}
